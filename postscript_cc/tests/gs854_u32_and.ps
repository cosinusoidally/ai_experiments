%!

% Minimal repro for the Ghostscript 8.54 numeric coercion bug seen when
% building mawkcc_self.c under pscc.ps. Old Ghostscript normalizes
% 4294967296 through /u32 to the real value 0.0, so the following "and"
% fails with /typecheck instead of producing 0.

/u32 {
    {
        dup 0 lt not { exit } if
        4294967296 add
    } loop
    {
        dup 4294967296 lt { exit } if
        4294967296 sub
    } loop
} bind def

4294967296 u32 type ==
4294967296 u32 ==
4294967296 u32 255 and ==

quit
