    exch patch_rel32
} bind def

/emit_add_eax_imm32 { 5 emit1 emit4 } bind def

/emit_shl_ebx_by_eax {
    137 emit1 193 emit1
    211 emit1 227 emit1
    137 emit1 216 emit1
} bind def

/emit_shr_ebx_by_eax {
    137 emit1 193 emit1
    211 emit1 235 emit1
    137 emit1 216 emit1
} bind def

/emit_sub_from_stack_top {
    137 emit1 193 emit1
    137 emit1 216 emit1
    41 emit1 200 emit1
