} bind def

/name_is_either {
    3 dict begin
    /rhs_b exch def
    /rhs_a exch def
    /lhs exch def
    lhs rhs_a eq
    lhs rhs_b eq
    or
    end
} bind def

/emit_brk_alloc {
    /init_skip 0 def
    /fail_patch 0 def
    /done_patch 0 def
    emit_mov_edx_eax
    161 emit1
    BRK_CUR_OFFSET emit4_data_patch
    emit_test_eax_eax
    /init_skip emit_jne_placeholder def

    45 emit_mov_eax_imm32
    emit_xor_ebx_ebx
    emit_int_80
    163 emit1
    BRK_CUR_OFFSET emit4_data_patch

    init_skip code_len patch_rel32

    139 emit1
    13 emit1
    BRK_CUR_OFFSET emit4_data_patch
    emit_mov_ebx_ecx
    emit_add_ebx_edx
    45 emit_mov_eax_imm32
    emit_int_80
    emit_cmp_eax_ebx
    /fail_patch emit_jne_placeholder def

    137 emit1
    29 emit1
    BRK_CUR_OFFSET emit4_data_patch
    emit_mov_eax_ecx
    /done_patch emit_jmp_placeholder def

    fail_patch code_len patch_rel32
    emit_xor_eax_eax
    done_patch code_len patch_rel32
} bind def

/emit_builtin1 {
    dup /neg /NEG name_is_either {
        pop emit_neg_eax
    }{
        dup /not /NOT name_is_either {
            pop emit_not_eax
        }{
            dup /ri32 eq {
                pop emit_read_i32
            }{
                dup /ri8 eq {
                    pop emit_read_u8
                }{
                    dup /brk eq {
                        pop emit_brk_alloc
                    }{
                        dup /close eq {
                            pop emit_sys_close
                        }{
                            dup /exit eq {
                                pop emit_sys_exit
                            }{
                                pop (unknown unary builtin) fail
                            } ifelse
                        } ifelse
                    } ifelse
                } ifelse
            } ifelse
        } ifelse
    } ifelse
} bind def

/emit_builtin2 {
    dup /add /ADD name_is_either {
        pop emit_add_eax_ebx
    }{
        dup /sub /SUB name_is_either {
            pop emit_sub_from_stack_top
        }{
            dup /mul /MUL name_is_either {
                pop emit_imul_eax_ebx
            }{
                dup /div /DIV name_is_either {
                    pop emit_div_stack_top_by_eax
                }{
                    dup /mod /MOD name_is_either {
                        pop emit_mod_stack_top_by_eax
                    }{
                        dup /eq /EQ name_is_either {
                            pop 148 emit_cmp_set
                        }{
                            dup /ne /NE name_is_either {
                                pop 149 emit_cmp_set
                            }{
                                dup /lt /LT name_is_either {
                                    pop 156 emit_cmp_set
                                }{
                                    dup /le /LE name_is_either {
                                        pop 158 emit_cmp_set
                                    }{
                                        dup /gt /GT name_is_either {
                                            pop 159 emit_cmp_set
                                        }{
                                            dup /ge /GE name_is_either {
                                                pop 157 emit_cmp_set
                                            }{
                                                dup /and /AND name_is_either {
                                                    pop emit_and_eax_ebx
                                                }{
                                                    dup /or /OR name_is_either {
                                                        pop emit_or_eax_ebx
                                                    }{
                                                        dup /xor /XOR name_is_either {
                                                            pop emit_xor_eax_ebx
                                                        }{
                                                            dup /shl /SHL name_is_either {
                                                                pop emit_shl_ebx_by_eax
                                                            }{
                                                                dup /shr /SHR name_is_either {
                                                                    pop emit_shr_ebx_by_eax
                                                                }{
                                                                    dup /wi32 eq {
                                                                        pop emit_write_i32
                                                                    }{
                                                                        dup /wi8 eq {
                                                                            pop emit_write_u8
                                                                        }{
                                                                            pop (unknown binary builtin) fail
                                                                        } ifelse
                                                                    } ifelse
                                                                } ifelse
                                                            } ifelse
                                                        } ifelse
                                                    } ifelse
                                                } ifelse
                                            } ifelse
                                        } ifelse
                                    } ifelse
                                } ifelse
                            } ifelse
                        } ifelse
                    } ifelse
                } ifelse
            } ifelse
        } ifelse
    } ifelse
} bind def

/emit_builtin3 {
    dup /open eq {
        pop emit_sys_open
    }{
        dup /read eq {
            pop emit_sys_read
        }{
            dup /write eq {
                pop emit_sys_write
            }{
                pop (unknown ternary builtin) fail
            } ifelse
        } ifelse
    } ifelse
} bind def

/emit_reverse_args {
    /era_argc exch def
    /era_i 0 def
    {
        era_i era_argc 2 idiv ge { exit } if
        /lo 4 era_i mul def
        /hi 4 era_argc 1 sub era_i sub mul def
        lo emit_mov_eax_stack_disp32
        hi emit_mov_ebx_stack_disp32
        lo emit_mov_stack_disp32_ebx
        hi emit_mov_stack_disp32_eax
        /era_i era_i 1 add def
    } loop
} bind def

/emit_user_call {
    /euc_argc exch def
    /euc_name exch def
    232 emit1
    /euc_call_patch code_len def
    0 emit4
    euc_argc 0 gt { euc_argc 4 mul emit_add_esp_imm32 } if
    call_target call_count euc_name put
    call_pos call_count euc_call_patch put
    call_argc call_count euc_argc put
    /call_count call_count 1 add store
} bind def

/parse_expr null def

/parse_builtin_call {
    8 dict begin
    /pbc_argc exch def
    /pbc_name exch def
    /LPAREN expect
    pbc_name /mks eq {
        tok /STR ne { (mks expects string literal) fail } if
        tok_text emit_mks_literal
        next_tok
        /RPAREN expect
    }{
        pbc_name /mkC eq {
            tok /STR ne { (mkC expects string literal) fail } if
            tok_text length 0 eq { 0 } { tok_text 0 get } ifelse
            emit_mov_eax_imm32
            next_tok
            /RPAREN expect
        }{
            pbc_argc 1 eq {
                parse_expr
            } if
            pbc_argc 2 eq {
                parse_expr
                emit_push_eax
                /COMMA expect
                parse_expr
                emit_pop_ebx
            } if
            pbc_argc 3 eq {
                parse_expr
                emit_push_eax
                /COMMA expect
                parse_expr
                emit_push_eax
                /COMMA expect
                parse_expr
                emit_mov_edx_eax
                emit_pop_ecx
                emit_pop_ebx
            } if
            /RPAREN expect
            pbc_argc 1 eq { pbc_name emit_builtin1 } if
            pbc_argc 2 eq { pbc_name emit_builtin2 } if
            pbc_argc 3 eq { pbc_name emit_builtin3 } if
        } ifelse
    } ifelse
    end
} bind def

/parse_user_call_args {
    6 dict begin
    /puca_argc 0 def
    /LPAREN expect
    tok /RPAREN eq {
        next_tok
    }{
        {
            parse_expr
            emit_push_eax
            /puca_argc puca_argc 1 add def
            tok /COMMA ne { exit } if
            next_tok
        } loop
        /RPAREN expect
        puca_argc emit_reverse_args
    } ifelse
    puca_argc
    end
} bind def

/parse_primary {
    tok /NUM eq {
        tok_num emit_mov_eax_imm32
        next_tok
    }{
        tok /STR eq {
            tok_text emit_mks_literal
            next_tok
        }{
            tok /LPAREN eq {
                next_tok
                parse_expr
                /RPAREN expect
            }{
                (expected expression) fail
            } ifelse
        } ifelse
    } ifelse
} bind def

/parse_assign_or_primary {
    8 dict begin
    /name tok_text cvn def
    next_tok
    tok /EQUAL eq {
        next_tok
        parse_expr
        current_param_offset name known {
            current_param_offset name get emit_store_param
        }{
            global_seen name known {
                name emit_store_global
            }{
                (invalid assignment target) fail
            } ifelse
        } ifelse
        }{
            tok /LPAREN eq {
                name builtin_arity /arity exch def
                arity 0 gt {
                    name arity parse_builtin_call
                }{
                    name parse_user_call_args emit_user_call
                } ifelse
            }{
            current_param_offset name known {
                current_param_offset name get emit_load_param
            }{
                global_seen name known {
                    name emit_load_global
                }{
                    (unknown identifier) fail
                } ifelse
            } ifelse
        } ifelse
    } ifelse
    end
} bind def

/parse_expr {
    tok /IDENT eq {
        parse_assign_or_primary
    }{
        parse_primary
    } ifelse
} bind def

/record_break {
    /patch_pos exch def
    /loop_id exch def
    break_loop break_total loop_id put
    break_patch break_total patch_pos put
    break_count loop_id break_count loop_id get 1 add put
    /break_total break_total 1 add store
} bind def

/push_loop {
    /exit_patch exch def
    /id next_loop_id def
    /next_loop_id next_loop_id 1 add store
    loop_stack loop_depth id put
    /loop_depth loop_depth 1 add store
    break_count id 0 put
    id
} bind def

/pop_loop {
    /loop_depth loop_depth 1 sub def
} bind def

/patch_breaks {
    10 dict begin
    /target exch def
    /loop_id exch def
    /i 0 def
    {
        i break_total ge { exit } if
        break_loop i get loop_id eq {
            break_patch i get target patch_rel32
        } if
        /i i 1 add def
    } loop
    end
} bind def

/parse_break {
    loop_depth 1 lt { (break outside loop) fail } if
    /BREAK expect
    /SEMI expect
    loop_stack loop_depth 1 sub get emit_jmp_placeholder record_break
} bind def

/parse_block {
    /LBRACE expect
    {
        tok /RBRACE eq tok /EOF eq or { exit } if
        parse_stmt
    } loop
    /RBRACE expect
} bind def

/parse_if {
    8 dict begin
    /IF expect
    /LPAREN expect
    parse_expr
    /RPAREN expect
    emit_test_eax_eax
    /false_patch emit_je_placeholder def
    parse_stmt
    tok /ELSE eq {
        /end_patch emit_jmp_placeholder def
        false_patch code_len patch_rel32
        next_tok
        parse_stmt
        end_patch code_len patch_rel32
    }{
        false_patch code_len patch_rel32
    } ifelse
    end
} bind def

/parse_while {
    8 dict begin
    /WHILE expect
    /LPAREN expect
    /loop_start code_len def
    parse_expr
    /RPAREN expect
    emit_test_eax_eax
    /exit_patch emit_je_placeholder def
    exit_patch push_loop /loop_id exch def
    parse_stmt
    loop_start emit_jmp
    exit_patch code_len patch_rel32
    loop_id code_len patch_breaks
    pop_loop
    end
} bind def

/parse_stmt {
    tok /LBRACE eq {
        parse_block
    }{
        tok /RETURN eq {
            next_tok
            parse_expr
            /SEMI expect
            emit_epilogue
        }{
            tok /IF eq {
                parse_if
            }{
                tok /WHILE eq {
                    parse_while
                }{
                    tok /BREAK eq {
                        parse_break
                    }{
                        parse_expr
                        /SEMI expect
                    } ifelse
                } ifelse
            } ifelse
        } ifelse
    } ifelse
} bind def

/enter_function {
    8 dict begin
    /param_count exch def
    /name exch def
    /current_function name store
    /current_param_offset 128 dict store
    /i 0 def
    {
        i param_count ge { exit } if
        current_param_offset param_names i get 8 4 i mul add put
        /i i 1 add def
    } loop
    end
} bind def

/leave_function {
    /current_function /none def
    /current_param_offset 64 dict def
} bind def

/parse_params {
    8 dict begin
    /pp_count 0 def
    tok /RPAREN eq {
    }{
        {
            tok /IDENT ne { (expected parameter name) fail } if
            /name tok_text cvn def
            current_param_offset name known { (duplicate parameter) fail } if
            current_param_offset name pp_count put
            param_names pp_count name put
            /pp_count pp_count 1 add def
            next_tok
            tok /COMMA ne { exit } if
            next_tok
        } loop
    } ifelse
    /current_param_offset 64 dict def
    pp_count
    end
} bind def

/parse_function {
    /FUNCTION expect
    tok /IDENT ne { (expected function name) fail } if
    tok_text trace_function_name
    /name tok_text cvn def
    next_tok
    /LPAREN expect
    parse_params /param_count exch def
    /RPAREN expect
    function_seen name known { (duplicate function) fail } if
    function_seen name true put
    function_arity name param_count put
    function_addr name code_len put
    function_name function_count name put
    /function_count function_count 1 add def
    emit_prologue
    name param_count enter_function
    /LBRACE expect
    {
        tok /RBRACE eq tok /EOF eq or { exit } if
        parse_stmt
    } loop
    /RBRACE expect
    0 emit_mov_eax_imm32
    emit_epilogue
    leave_function
    trace_stack_depth
} bind def

/parse_global {
    /VAR expect
    tok /IDENT ne { (expected global name) fail } if
    /name tok_text cvn def
    next_tok
    tok /EQUAL eq { (global initializers unsupported) fail } if
    /SEMI expect
    global_seen name known function_seen name known or { (duplicate global) fail } if
    global_seen name true put
    global_name global_count name put
    /global_count global_count 1 add def
    global_bytes next_data_offset lt not {
    }{
        /global_bytes next_data_offset align4 def
        /next_data_offset global_bytes def
    } ifelse
    global_offset name global_bytes put
    /global_bytes global_bytes 4 add def
    next_data_offset global_bytes lt { /next_data_offset global_bytes def } if
    data_used global_bytes lt { /data_used global_bytes def } if
} bind def

/parse_program {
    {
        tok /EOF eq { exit } if
        tok /VAR eq {
            parse_global
        }{
            parse_function
        } ifelse
    } loop
    function_seen /main known not { (missing main function) fail } if
} bind def

/patch_calls {
    /i 0 def
    {
        i call_count ge { exit } if
        /TRACE_PATCH where {
            pop
            TRACE_PATCH 0 ne i 1000 mod 0 eq and {
                (patch_calls i=) trace_msg
            } if
        } if
        /name call_target i get def
        /argc call_argc i get def
        function_seen name known not { (undefined function call) fail } if
        function_arity name get argc ne { (wrong function arity) fail } if
        call_pos i get
        function_addr name get
        patch_rel32
        /i i 1 add def
    } loop
} bind def

/bout1 {
    out_byte 0 3 -1 roll put
    outf out_byte writestring
    /bin_len bin_len 1 add def
} bind def

/bout2 {
    dup 255 and bout1
    -8 bitshift 255 and bout1
} bind def

/bout4 {
    u32 /n exch def
    n 255 and bout1
    n -8 bitshift 255 and bout1
    n -16 bitshift 255 and bout1
    n -24 bitshift 255 and bout1
} bind def

/boutstr {
    outf exch writestring
    /bin_len bin_len 1 index length add def
} bind def

/pad_to {
    {
        bin_len 1 index ge { exit } if
        0 bout1
    } loop
    pop
} bind def

/build_binary {
    20 dict begin
    /base 134512640 def
    /ehsize 52 def
    /phsize 32 def
    /headers ehsize phsize add def
    /entry base headers add def
    /data_off headers code_len add align4 def
    /data_base base data_off add def
    /filesz data_off data_used add def
    /memsz filesz def
    /flags 7 def

    function_addr /main get start_call_patch 4 add sub
    start_call_patch exch patch4

    /i 0 def
    {
        i data_patch_count ge { exit } if
        data_patch_offset i get
        data_base data_patch_addend i get add
        patch4
        /i i 1 add def
    } loop

    /outf /OUT where {
        pop OUT (w) file
    }{
        (%stdout) (w) file
    } ifelse def
    /bin_len 0 def

    127 bout1 69 bout1 76 bout1 70 bout1
    1 bout1 1 bout1 1 bout1 0 bout1
    0 bout1 0 bout1 0 bout1 0 bout1
    0 bout1 0 bout1 0 bout1 0 bout1

    2 bout2
    3 bout2
    1 bout4
    entry bout4
    ehsize bout4
    0 bout4
    0 bout4
    ehsize bout2
    phsize bout2
    1 bout2
    0 bout2
    0 bout2
    0 bout2

    1 bout4
    0 bout4
    base bout4
    base bout4
    filesz bout4
    memsz bout4
    flags bout4
    4096 bout4

    /i 0 def
    {
        i code_len ge { exit } if
        codebuf i buf_get1 bout1
        /i i 1 add def
    } loop
    data_off pad_to

    /i 0 def
    {
        i data_used ge { exit } if
        databuf i buf_get1_or_zero bout1
        /i i 1 add def
    } loop
    outf closefile
    end
} bind def

/main {
    init_tables
    code_reset
    (read_source) trace_msg
    read_source
    (next_tok) trace_msg
    next_tok
    (emit_start) trace_msg
    emit_start
    (parse_program) trace_msg
    parse_program
    /EOF expect
    (patch_calls) trace_msg
    patch_calls
    (build_binary) trace_msg
    build_binary
    quit
} bind def

main
