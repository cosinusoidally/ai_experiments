/emit_mov_stack_disp32_eax {
    137 emit1
    132 emit1
    36 emit1
    emit4
} bind def

/emit_je_placeholder {
    15 emit1
    132 emit1
    /pos code_len def
    0 emit4
    pos
} bind def

/emit_jne_placeholder {
    15 emit1
    133 emit1
    /pos code_len def
    0 emit4
    pos
} bind def

/emit_jmp_placeholder {
