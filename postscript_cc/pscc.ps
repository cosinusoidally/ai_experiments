    137 emit1 208 emit1
} bind def

/emit_cmp_set {
    /opcode exch def
    57 emit1 195 emit1
    15 emit1 opcode emit1 192 emit1
    15 emit1 182 emit1 192 emit1
} bind def

/emit_not_eax {
    133 emit1 192 emit1
    15 emit1 148 emit1 192 emit1
    15 emit1 182 emit1 192 emit1
} bind def

