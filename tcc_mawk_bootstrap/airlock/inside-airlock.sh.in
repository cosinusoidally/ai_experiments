#!/bin/sh
set -eu

cd /work
mkdir -p \
  build \
  extracted/tcc \
  extracted/musl \
  bootstrap/common/lib/tcc/include \
  bootstrap/wrap-headers \
  bootstrap/stage0 \
  bootstrap/stage1 \
  bootstrap/stage2

host_artifact_root=${HOST_ARTIFACT_ROOT:?}
host_common_tccdir="$host_artifact_root/common/lib/tcc"
host_musl_include="$host_artifact_root/musl-headers/include"
host_stage2_tcc="$host_artifact_root/stage2/tcc"
host_stage2_driver="$host_artifact_root/stage2/tcc-driver"
host_stage2_glibc="$host_artifact_root/stage2/tcc-glibc"

seed_cflags='-nostdinc -I/work/seed-headers -I/work/src'
seed_ldflags='-nostdlib -L/lib -L/usr/lib /work/crt.c /lib/libc.so.6'

./tcc-seed -B/work/seed-tccdir $seed_cflags $seed_ldflags /work/src/M2libc/bootstrappable.c /work/src/unbz2.c -o /work/build/unbz2
./tcc-seed -B/work/seed-tccdir $seed_cflags $seed_ldflags /work/src/M2libc/bootstrappable.c /work/src/untar.c -o /work/build/untar

/work/build/unbz2 --file /work/tcc-0.9.27.tar.bz2 --output /work/extracted/tcc.tar
( cd /work/extracted/tcc && /work/build/untar --file /work/extracted/tcc.tar )

gzip -dc /work/musl-1.1.24.tar.gz > /work/extracted/musl.tar
( cd /work/extracted/musl && /work/build/untar --file /work/extracted/musl.tar )

srcdir=/work/extracted/tcc/tcc-0.9.27
musl_src=/work/extracted/musl/musl-1.1.24
musl_inc=/work/bootstrap/musl-headers/include
common=/work/bootstrap/common/lib/tcc
wrap_inc=/work/bootstrap/wrap-headers
version=$(mawk 'NR == 1 { print; exit }' "$srcdir/VERSION")

mkdir -p "$musl_inc/bits"
cp -Rf "$musl_src/include/." "$musl_inc"
cp -Rf "$musl_src/arch/generic/bits/." "$musl_inc/bits"
cp -Rf "$musl_src/arch/i386/bits/." "$musl_inc/bits"
sed -f "$musl_src/tools/mkalltypes.sed" \
  "$musl_src/arch/i386/bits/alltypes.h.in" \
  "$musl_src/include/alltypes.h.in" \
  > "$musl_inc/bits/alltypes.h"
cp -f "$musl_src/arch/i386/bits/syscall.h.in" "$musl_inc/bits/syscall.h"
mawk 'sub(/^__NR_/, "SYS_") { print }' \
  "$musl_src/arch/i386/bits/syscall.h.in" >> "$musl_inc/bits/syscall.h"

cp -Rf /work/airlock/build-headers/. "$wrap_inc/"
mawk -v musl_inc="$musl_inc" '
  {
    gsub(/__MUSL_INCLUDE__/, musl_inc);
    print;
  }
' "$wrap_inc/stdarg.h" > "$wrap_inc/stdarg.h.new"
mv "$wrap_inc/stdarg.h.new" "$wrap_inc/stdarg.h"
mawk -v musl_inc="$musl_inc" '
  {
    gsub(/__MUSL_INCLUDE__/, musl_inc);
    print;
  }
' "$wrap_inc/stdio.h" > "$wrap_inc/stdio.h.new"
mv "$wrap_inc/stdio.h.new" "$wrap_inc/stdio.h"

cp -Rf "$srcdir/include/." "$common/include/"
cp -f "$srcdir/tcclib.h" "$common/include/"

write_config() {
  stage_dir=$1
  cat > "$stage_dir/config.h" <<CFG
/* generated inside airlock */
#ifndef CONFIG_TCCDIR
# define CONFIG_TCCDIR "$host_common_tccdir"
#endif
#ifndef CONFIG_TCC_CRTPREFIX
# define CONFIG_TCC_CRTPREFIX "/usr/lib32:/lib32:/usr/lib/i386-linux-gnu:/lib/i386-linux-gnu"
#endif
#ifndef CONFIG_TCC_LIBPATHS
# define CONFIG_TCC_LIBPATHS "/usr/lib32:/lib32:/usr/lib/i386-linux-gnu:/lib/i386-linux-gnu"
#endif
#define TCC_VERSION "$version"
CFG
}

write_driver() {
  out=$1
  tcc_real=$2
  common_tccdir=$3
  wrap_include=$4
  musl_include=$5
  crt_c=$6
  libc_so=$7
  libm_so=$8
  libdl_so=$9

  cp -f /work/airlock/tcc-driver.sh.in "$out"
  mawk \
    -v tcc_real="$tcc_real" \
    -v common_tccdir="$common_tccdir" \
    -v wrap_include="$wrap_include" \
    -v musl_include="$musl_include" \
    -v crt_c="$crt_c" \
    -v libc_so="$libc_so" \
    -v libm_so="$libm_so" \
    -v libdl_so="$libdl_so" '
      {
        gsub(/__TCC_REAL__/, tcc_real);
        gsub(/__COMMON_TCCDIR__/, common_tccdir);
        gsub(/__WRAP_INCLUDE__/, wrap_include);
        gsub(/__MUSL_INCLUDE__/, musl_include);
        gsub(/__CRT_C__/, crt_c);
        gsub(/__LIBC_SO__/, libc_so);
        gsub(/__LIBM_SO__/, libm_so);
        gsub(/__LIBDL_SO__/, libdl_so);
        print;
      }
    ' "$out" > "$out.new"
  mv "$out.new" "$out"
  chmod 0755 "$out"
}

write_glibc_wrapper() {
  out=$1
  driver=$2
  cp -f /work/airlock/tcc-glibc.sh.in "$out"
  mawk -v driver="$driver" '
    {
      gsub(/__TCC_DRIVER__/, driver);
      print;
    }
  ' "$out" > "$out.new"
  mv "$out.new" "$out"
  chmod 0755 "$out"
}

build_libtcc1() {
  cc=$1
  obj_dir=/work/bootstrap/libtcc1
  mkdir -p "$obj_dir"
  rm -f "$obj_dir"/*.o "$common/libtcc1.a"

  ( cd "$obj_dir" && "$cc" -c "$srcdir/lib/libtcc1.c" -o libtcc1.o -I"$srcdir" )
  ( cd "$obj_dir" && "$cc" -c "$srcdir/lib/alloca86.S" -o alloca86.o -I"$srcdir" )
  cp -f "$obj_dir/libtcc1.o" "$common/libtcc1.o"
  cp -f "$obj_dir/alloca86.o" "$common/alloca86.o"
  /work/tcc-seed -ar rcs "$common/libtcc1.a" \
    "$obj_dir/libtcc1.o" \
    "$obj_dir/alloca86.o"
}

build_stage() {
  stage=$1
  cc=$2
  stage_dir=/work/bootstrap/$stage
  write_config "$stage_dir"
  ( cd "$stage_dir" && "$cc" -DONE_SOURCE=1 -c "$srcdir/tcc.c" -o tcc.o -I. -I"$srcdir" )
  "$cc" "$stage_dir/tcc.o" -o "$stage_dir/tcc" -I"$stage_dir" -I"$srcdir"
}

write_driver /work/bootstrap/seed-driver /work/tcc-seed "$common" "$wrap_inc" "$musl_inc" /work/crt.c /lib/libc.so.6 /lib/libm.so.6 /lib/libdl.so.2
build_libtcc1 /work/bootstrap/seed-driver
build_stage stage0 /work/bootstrap/seed-driver
write_driver /work/bootstrap/stage0-driver /work/bootstrap/stage0/tcc "$common" "$wrap_inc" "$musl_inc" /work/crt.c /lib/libc.so.6 /lib/libm.so.6 /lib/libdl.so.2
build_stage stage1 /work/bootstrap/stage0-driver
write_driver /work/bootstrap/stage1-driver /work/bootstrap/stage1/tcc "$common" "$wrap_inc" "$musl_inc" /work/crt.c /lib/libc.so.6 /lib/libm.so.6 /lib/libdl.so.2
build_stage stage2 /work/bootstrap/stage1-driver

write_driver /work/bootstrap/stage2/tcc-driver "$host_stage2_tcc" "$host_common_tccdir" "$host_artifact_root/wrap-headers" "$host_musl_include" "$host_artifact_root/crt.c" /usr/lib32/libc.so.6 /usr/lib32/libm.so.6 /usr/lib32/libdl.so.2
write_glibc_wrapper /work/bootstrap/stage2/tcc-glibc /work/bootstrap/stage2/tcc-driver
/work/bootstrap/stage2/tcc -v
