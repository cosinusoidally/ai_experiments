+#!/bin/sh
+
+# Build the ordinary GCC driver/test harness, substitute the already-built
+# unified cc1 for the duration of the full C testsuite, and compare results
+# with the checked-in baseline.  Run from an out-of-tree build directory.
+
+set -eux
+
+source_root=`CDPATH= cd "\`dirname "$0"\`" && pwd`
+build_root=`pwd`
+artifact_root=${UNIFIED_ARTIFACTS-$build_root/unified-artifacts}
+unified_cc1=${UNIFIED_CC1-$artifact_root/cc1_unified}
+test_tools=${TEST_TOOLS-/tmp/test_tools}
+make_program=${MAKE-make}
+saved_cc1=$build_root/gcc/cc1.conventional-for-unified-check
+
+test "$build_root" != "$source_root" || {
+  echo "run check-cc1-unified.sh from an out-of-tree build directory" >&2
+  exit 1
+}
+
+if test ! -x "$unified_cc1"; then
+  "$source_root/build-cc1-unified.sh"
+fi
+
+if test ! -x "$test_tools/bin/runtest" || \
+   test ! -x "$test_tools/bin/expect"; then
+  echo "DejaGnu/Expect are missing under $test_tools" >&2
+  echo "Build /home/foo/src/test_deps with build-test-tools-etch.sh first." >&2
+  exit 1
+fi
+
+# xgcc, collect2, specs, libgcc, headers, and DejaGnu's site files belong to
+# the ordinary test harness.  cc1 itself is replaced only after that harness
+# is current, preventing Make from rebuilding over the unified executable.
+"$source_root/build.sh" all-gcc
+
+test -x "$build_root/gcc/cc1" || {
+  echo "the conventional test harness did not produce gcc/cc1" >&2
+  exit 1
+}
+test ! -e "$saved_cc1" || {
+  echo "stale saved compiler exists: $saved_cc1" >&2
+  echo "restore or remove it before running this script" >&2
+  exit 1
+}
+
+restore_cc1 ()
+{
+  if test -e "$saved_cc1"; then
+    mv -f "$saved_cc1" "$build_root/gcc/cc1"
+  fi
+}
+trap restore_cc1 0 1 2 3 15
+
+mv "$build_root/gcc/cc1" "$saved_cc1"
+cp "$unified_cc1" "$build_root/gcc/cc1"
+chmod 755 "$build_root/gcc/cc1"
+touch "$build_root/gcc/cc1"
+
+echo "Unified compiler installed in test harness"
+sha256sum "$unified_cc1" "$build_root/gcc/cc1"
+
+PATH=$test_tools/bin:$PATH
+LANG=C
+LC_ALL=C
+export PATH LANG LC_ALL
+
+suite_status=0
+"$make_program" -k check-gcc || suite_status=$?
+
+sum_file=$build_root/gcc/testsuite/gcc/gcc.sum
+compare_status=0
+"$source_root/contrib/compare-cc1-unified-testsuite.sh" "$sum_file" || \
+  compare_status=$?
+
+if test "$suite_status" -ne 0; then
+  echo "make -k check-gcc returned $suite_status" >&2
+fi
+if test "$compare_status" -ne 0; then
+  echo "testsuite results differ from the recorded baseline" >&2
+  exit "$compare_status"
+fi
+exit "$suite_status"
