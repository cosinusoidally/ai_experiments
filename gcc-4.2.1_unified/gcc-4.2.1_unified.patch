@@ -0,0 +1,58 @@
+#!/bin/sh
+
+set -eu
+
+if test "$#" -ne 1; then
+  echo "usage: $0 CONFIGURED_BUILD_DIRECTORY" >&2
+  exit 2
+fi
+
+script_dir=`CDPATH= cd -- "\`dirname -- "$0"\`" && pwd`
+source_root=`CDPATH= cd -- "$script_dir/.." && pwd`
+manifest=$source_root/gcc/cc1-unified-sources.manifest
+build_root=$1
+
+if test ! -f "$manifest"; then
+  echo "error: source manifest not found: $manifest" >&2
+  exit 1
+fi
+
+if test ! -f "$build_root/gcc/config.h"; then
+  echo "error: configured GCC build not found: $build_root" >&2
+  exit 1
+fi
+
+echo '/* Diagnostic prototype generated by generate-cc1-unified-prototype.sh. */'
+echo '/* This is not the final self-contained gcc/cc1_unified.c. */'
+echo '#define IN_GCC 1'
+echo '#define HAVE_CONFIG_H 1'
+echo '#define GCC_UNIFIED_CC1 1'
+echo
+
+awk -v build_root="$build_root" '
+  /^#/ { next }
+  {
+    origin = $4
+
+    if (origin ~ /^source:gcc\//)
+      {
+        sub(/^source:gcc\//, "", origin)
+        print "#include \"" origin "\""
+      }
+    else if (origin ~ /^source:/)
+      {
+        sub(/^source:/, "", origin)
+        print "#include \"../" origin "\""
+      }
+    else if (origin ~ /^build:gcc\//)
+      {
+        sub(/^build:gcc\//, "", origin)
+        print "#include \"" build_root "/gcc/" origin "\""
+      }
+    else
+      {
+        print "error: unknown manifest origin " $4 > "/dev/stderr"
+        exit 1
+      }
+  }
+' "$manifest"
