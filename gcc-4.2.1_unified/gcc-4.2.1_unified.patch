@@ -0,0 +1,168 @@
+#!/bin/sh
+
+# Build the fixed i686-linux cc1 without configure and compile the complete
+# compiler implementation with exactly one invocation of the selected C
+# compiler.  All generated inputs remain below unified-artifacts.
+
+set -eux
+
+source_root=`CDPATH= cd "\`dirname "$0"\`" && pwd`
+build_root=`pwd`
+artifact_root=${UNIFIED_ARTIFACTS-$build_root/unified-artifacts}
+generated_root=$artifact_root/generated/gcc
+libiberty_generated_root=$artifact_root/generated/libiberty
+tool_root=$artifact_root/generators
+compiler=${CC-/usr/bin/gcc}
+bootstrap_compiler=${CC_FOR_BUILD-$compiler}
+md_file=$source_root/gcc/config/i386/i386.md
+
+test "$build_root" != "$source_root" || {
+  echo "run build-cc1-unified.sh from an out-of-tree build directory" >&2
+  exit 1
+}
+command -v "$compiler" >/dev/null 2>&1 || {
+  echo "compiler is missing: $compiler" >&2
+  exit 1
+}
+command -v "$bootstrap_compiler" >/dev/null 2>&1 || {
+  echo "build compiler is missing: $bootstrap_compiler" >&2
+  exit 1
+}
+
+mkdir -p "$generated_root" "$libiberty_generated_root" "$tool_root"
+cp "$source_root"/gcc/unified-i686-config/*.h "$generated_root"/
+cp "$source_root/gcc/unified-i686-config/libiberty-config.h" \
+  "$libiberty_generated_root/config.h"
+
+echo "Preparing fixed i686 option tables"
+"${AWK-awk}" -f "$source_root/gcc/opt-gather.awk" \
+  "$source_root/gcc/ada/lang.opt" \
+  "$source_root/gcc/fortran/lang.opt" \
+  "$source_root/gcc/java/lang.opt" \
+  "$source_root/gcc/treelang/lang.opt" \
+  "$source_root/gcc/c.opt" "$source_root/gcc/common.opt" \
+  "$source_root/gcc/config/i386/i386.opt" \
+  "$source_root/gcc/config/linux.opt" > "$generated_root/optionlist"
+"${AWK-awk}" -f "$source_root/gcc/opt-functions.awk" \
+  -f "$source_root/gcc/opth-gen.awk" \
+  < "$generated_root/optionlist" > "$generated_root/options.h"
+"${AWK-awk}" -f "$source_root/gcc/opt-functions.awk" \
+  -f "$source_root/gcc/optc-gen.awk" \
+  -v header_name="config.h system.h coretypes.h tm.h" \
+  < "$generated_root/optionlist" > "$generated_root/options.c"
+
+build_flags="-O0 -g -DHAVE_CONFIG_H -I$generated_root -I$source_root/include"
+gen_flags="$build_flags -DIN_GCC -DGENERATOR_FILE -I$tool_root -I$source_root/gcc -I$source_root/libcpp/include"
+libiberty_flags="-O0 -g -DHAVE_CONFIG_H -I$libiberty_generated_root -I$source_root/include"
+
+echo "Building complete unified libiberty"
+"$compiler" -c $libiberty_flags \
+  "$source_root/libiberty/libiberty_unified.c" \
+  -o "$artifact_root/libiberty_unified.o"
+rm -f "$artifact_root/libiberty.a"
+ar cr "$artifact_root/libiberty.a" "$artifact_root/libiberty_unified.o"
+ranlib "$artifact_root/libiberty.a"
+
+compile_generator_object ()
+{
+  generator_name=$1
+  generator_source=${2-$source_root/gcc/$generator_name.c}
+  "$bootstrap_compiler" -c $gen_flags "$generator_source" \
+    -o "$tool_root/$generator_name.o"
+}
+
+link_generator ()
+{
+  link_name=$1
+  shift
+  "$bootstrap_compiler" -O0 -g -o "$tool_root/$link_name" \
+    "$tool_root/$link_name.o" "$@" "$artifact_root/libiberty.a"
+}
+
+compile_generator_object errors
+compile_generator_object genmodes
+link_generator genmodes "$tool_root/errors.o"
+"$tool_root/genmodes" > "$generated_root/insn-modes.c"
+"$tool_root/genmodes" -h > "$generated_root/insn-modes.h"
+"$tool_root/genmodes" -m > "$generated_root/min-insn-modes.c"
+
+"${AWK-awk}" -v srcdir="$source_root/gcc" \
+  -f "$source_root/contrib/make-unified-gtyp-gen.awk" \
+  "$source_root/gcc/unified-i686-gengtype.files" \
+  > "$generated_root/gtyp-gen.h"
+for name in gengtype gengtype-lex gengtype-yacc; do
+  compile_generator_object "$name"
+done
+link_generator gengtype "$tool_root/gengtype-lex.o" \
+  "$tool_root/gengtype-yacc.o" "$tool_root/errors.o"
+(cd "$generated_root" && "$tool_root/gengtype")
+
+printf '%s\n' '#include "ada/ada-tree.def"' '#include "cp/cp-tree.def"' \
+  '#include "java/java-tree.def"' '#include "objc/objc-tree.def"' \
+  > "$generated_root/gencheck.h"
+compile_generator_object gencheck
+link_generator gencheck
+"$tool_root/gencheck" > "$generated_root/tree-check.h"
+
+for name in rtl read-rtl ggc-none vec gensupport print-rtl; do
+  compile_generator_object "$name"
+done
+"$bootstrap_compiler" -c $gen_flags "$generated_root/min-insn-modes.c" \
+  -o "$tool_root/min-insn-modes.o"
+md_objects="$tool_root/rtl.o $tool_root/read-rtl.o $tool_root/ggc-none.o $tool_root/vec.o $tool_root/min-insn-modes.o $tool_root/gensupport.o $tool_root/print-rtl.o $tool_root/errors.o"
+
+for name in attr attrtab automata codes conditions config constants emit extract flags mddeps opinit output peep preds recog; do
+  compile_generator_object "gen$name"
+  extra=""
+  test "$name" != automata || extra=-lm
+  link_generator "gen$name" $md_objects $extra
+done
+
+"$tool_root/genconstants" "$md_file" > "$generated_root/insn-constants.h"
+"$tool_root/genpreds" "$md_file" > "$generated_root/insn-preds.c"
+"$tool_root/genpreds" -h "$md_file" > "$generated_root/tm-preds.h"
+"$tool_root/genpreds" -c "$md_file" > "$generated_root/tm-constrs.h"
+"$tool_root/genconditions" "$md_file" > "$tool_root/gencondmd.c"
+compile_generator_object gencondmd "$tool_root/gencondmd.c"
+link_generator gencondmd
+"$tool_root/gencondmd" > "$generated_root/insn-conditions.md"
+
+for name in attr codes config flags; do
+  "$tool_root/gen$name" "$md_file" "$generated_root/insn-conditions.md" \
+    > "$generated_root/insn-$name.h"
+done
+for name in attrtab emit extract opinit output peep recog; do
+  "$tool_root/gen$name" "$md_file" "$generated_root/insn-conditions.md" \
+    > "$generated_root/insn-$name.c"
+done
+"$tool_root/genautomata" "$md_file" "$generated_root/insn-conditions.md" \
+  > "$generated_root/insn-automata.c" 2> "$artifact_root/genautomata.log"
+compile_generator_object gengenrtl
+link_generator gengenrtl "$tool_root/errors.o"
+"$tool_root/gengenrtl" > "$generated_root/genrtl.c"
+"$tool_root/gengenrtl" -h > "$generated_root/genrtl.h"
+
+compile_generator_object gcov-iov
+link_generator gcov-iov
+"$tool_root/gcov-iov" '4.2.1' '' > "$generated_root/gcov-iov.h"
+printf '%s\n' 'const unsigned char executable_checksum[16] = { 0 };' \
+  > "$generated_root/cc1-checksum.c"
+
+core_flags="-c -O0 -g -DIN_GCC -DHAVE_CONFIG_H -I$generated_root -I$source_root/gcc -I$source_root/include -I$source_root/libcpp/include -I$source_root/libdecnumber"
+
+echo "Compiling gcc/cc1_unified.c once with $compiler"
+start=`date +%s`
+"$compiler" $core_flags "$source_root/gcc/cc1_unified.c" \
+  -o "$artifact_root/cc1_unified.o"
+end=`date +%s`
+echo `expr "$end" - "$start"` > "$artifact_root/cc1-unified-compile-seconds"
+
+echo "Linking unified cc1"
+"$compiler" -O0 -g -o "$artifact_root/cc1_unified" \
+  "$artifact_root/cc1_unified.o" "$artifact_root/libiberty.a"
+
+printf '%s\n' 'int main(void) { return 0; }' > "$artifact_root/smoke.c"
+"$artifact_root/cc1_unified" -quiet "$artifact_root/smoke.c" \
+  -o "$artifact_root/smoke.s"
+test -s "$artifact_root/smoke.s"
+echo "Built and smoke-tested $artifact_root/cc1_unified"
