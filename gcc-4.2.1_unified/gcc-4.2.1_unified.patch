index 00000000..23026c75
--- /dev/null
+++ b/contrib/analyze-cc1-unified.sh
@@ -0,0 +1,169 @@
+#!/bin/sh
+
+set -eu
+
+if test "$#" -ne 1; then
+  echo "usage: $0 CONFIGURED_BUILD_DIRECTORY" >&2
+  exit 2
+fi
+
+script_dir=`CDPATH= cd -- "\`dirname -- "$0"\`" && pwd`
+source_root=`CDPATH= cd -- "$script_dir/.." && pwd`
+build_root=$1
+link_map=$build_root/gcc/cc1.link.map
+
+if test ! -f "$link_map"; then
+  echo "error: linker map not found: $link_map" >&2
+  echo "relink cc1 with -Wl,-Map=cc1.link.map,--cref first" >&2
+  exit 1
+fi
+
+for archive in \
+  "$build_root/gcc/libbackend.a" \
+  "$build_root/libcpp/libcpp.a" \
+  "$build_root/libdecnumber/libdecnumber.a" \
+  "$build_root/libiberty/libiberty.a"
+do
+  if test ! -f "$archive"; then
+    echo "error: archive not found: $archive" >&2
+    exit 1
+  fi
+done
+
+tmp_root=${TMPDIR-/tmp}
+tmp_dir=`mktemp -d "$tmp_root/cc1-unified-analysis.XXXXXX"`
+
+cleanup ()
+{
+  if test -n "$tmp_dir" && test -d "$tmp_dir"; then
+    rm -r -- "$tmp_dir"
+  fi
+}
+
+trap cleanup EXIT HUP INT TERM
+
+extract_selected ()
+{
+  archive_name=$1
+  output=$2
+
+  sed -n "s/.*${archive_name}\\.a(\\([^)]*\\)).*/\\1/p" "$link_map" \
+    | sort -u > "$output"
+}
+
+archive_order ()
+{
+  archive=$1
+  selected=$2
+
+  ar t "$archive" \
+    | awk 'NR == FNR { selected[$1] = 1; next }
+           selected[$1] { print $1 }' "$selected" -
+}
+
+extract_selected libbackend "$tmp_dir/backend.selected"
+extract_selected libcpp "$tmp_dir/libcpp.selected"
+extract_selected libdecnumber "$tmp_dir/libdecnumber.selected"
+extract_selected libiberty "$tmp_dir/libiberty.selected"
+
+archive_order "$build_root/gcc/libbackend.a" "$tmp_dir/backend.selected" \
+  > "$tmp_dir/backend.ordered"
+archive_order "$build_root/libcpp/libcpp.a" "$tmp_dir/libcpp.selected" \
+  > "$tmp_dir/libcpp.ordered"
+archive_order "$build_root/libdecnumber/libdecnumber.a" \
+  "$tmp_dir/libdecnumber.selected" > "$tmp_dir/libdecnumber.ordered"
+archive_order "$build_root/libiberty/libiberty.a" \
+  "$tmp_dir/libiberty.selected" > "$tmp_dir/libiberty.ordered"
+
+awk '$1 == "LOAD" && $2 == "c-lang.o" { active = 1 }
+     active && $2 ~ /^[^\/]*[.]o$/ { print $2 }
+     active && $2 == "main.o" { exit }' "$link_map" \
+  > "$tmp_dir/direct.ordered"
+
+sequence=0
+
+emit ()
+{
+  component=$1
+  object=$2
+  origin=$3
+  sequence=`expr "$sequence" + 1`
+  printf '%04d\t%s\t%s\t%s\n' "$sequence" "$component" "$object" "$origin"
+}
+
+map_gcc_object ()
+{
+  component=$1
+  object=$2
+  stem=${object%.o}
+
+  if test -f "$build_root/gcc/$stem.c"; then
+    emit "$component-generated" "$object" "build:gcc/$stem.c"
+    return
+  fi
+
+  if test -f "$source_root/gcc/$stem.c"; then
+    emit "$component-source" "$object" "source:gcc/$stem.c"
+    return
+  fi
+
+  matches=`find "$source_root/gcc/config" -type f -name "$stem.c" -print`
+  count=`printf '%s\n' "$matches" | sed '/^$/d' | wc -l`
+
+  if test "$count" -eq 1; then
+    relative=${matches#"$source_root/"}
+    emit "$component-target" "$object" "source:$relative"
+    return
+  fi
+
+  echo "error: cannot uniquely map $component object $object" >&2
+  if test -n "$matches"; then
+    printf '%s\n' "$matches" >&2
+  fi
+  exit 1
+}
+
+echo '# order component object origin'
+
+while IFS= read -r object
+do
+  map_gcc_object direct "$object"
+done < "$tmp_dir/direct.ordered"
+
+while IFS= read -r object
+do
+  map_gcc_object backend "$object"
+done < "$tmp_dir/backend.ordered"
+
+while IFS= read -r object
+do
+  stem=${object%.o}
+  source=$source_root/libcpp/$stem.c
+  if test ! -f "$source"; then
+    echo "error: cannot map libcpp object $object to $source" >&2
+    exit 1
+  fi
+  emit libcpp-source "$object" "source:libcpp/$stem.c"
+done < "$tmp_dir/libcpp.ordered"
+
+while IFS= read -r object
+do
+  stem=${object%.o}
+  source=$source_root/libdecnumber/$stem.c
+  if test ! -f "$source"; then
+    echo "error: cannot map libdecnumber object $object to $source" >&2
+    exit 1
+  fi
+  emit libdecnumber-source "$object" "source:libdecnumber/$stem.c"
+done < "$tmp_dir/libdecnumber.ordered"
+
+while IFS= read -r object
+do
+  stem=${object%.o}
+  source=$source_root/libiberty/$stem.c
+  if test ! -f "$source"; then
+    echo "error: cannot map libiberty object $object to $source" >&2
+    exit 1
+  fi
+  emit libiberty-source "$object" "source:libiberty/$stem.c"
+done < "$tmp_dir/libiberty.ordered"
diff --git a/contrib/audit-cc1-unified-headers.sh b/contrib/audit-cc1-unified-headers.sh
new file mode 100755
index 00000000..b0f6c29d
--- /dev/null
+++ b/contrib/audit-cc1-unified-headers.sh
@@ -0,0 +1,122 @@
+#!/bin/sh
+
+set -eu
+
+if test "$#" -ne 2; then
+  echo "usage: $0 CONFIGURED_BUILD_DIRECTORY GCC_H_TRACE" >&2
+  exit 2
+fi
+
+script_dir=`CDPATH= cd -- "\`dirname -- "$0"\`" && pwd`
+source_root=`CDPATH= cd -- "$script_dir/.." && pwd`
+build_root=$1
+trace_file=$2
+
+if test ! -d "$build_root/gcc"; then
+  echo "error: configured GCC directory not found: $build_root/gcc" >&2
+  exit 1
+fi
+
+if test ! -f "$trace_file"; then
+  echo "error: GCC -H trace not found: $trace_file" >&2
+  exit 1
+fi
+
+tmp_root=${TMPDIR-/tmp}
+tmp_dir=`mktemp -d "$tmp_root/cc1-unified-headers.XXXXXX"`
+
+cleanup ()
+{
+  if test -n "$tmp_dir" && test -d "$tmp_dir"; then
+    rm -r -- "$tmp_dir"
+  fi
+}
+
+trap cleanup EXIT HUP INT TERM
+
+sed -n 's/^\.* //p' "$trace_file" > "$tmp_dir/opened"
+
+while IFS= read -r opened
+do
+  case $opened in
+    *.h|*.def|*.inc)
+      ;;
+    *)
+      continue
+      ;;
+  esac
+
+  case $opened in
+    /*)
+      candidate=$opened
+      ;;
+    *)
+      candidate=$source_root/gcc/$opened
+      ;;
+  esac
+
+  canonical=`readlink -f "$candidate" 2>/dev/null || true`
+  if test -z "$canonical" || test ! -f "$canonical"; then
+    continue
+  fi
+
+  case $canonical in
+    "$source_root"/*|"$build_root"/*)
+      printf '%s\n' "$canonical"
+      ;;
+  esac
+done < "$tmp_dir/opened" > "$tmp_dir/project-opened"
+
+sort "$tmp_dir/project-opened" \
+  | uniq -c \
+  | sed 's/^[[:space:]]*//' \
+  | sort -k2,2 > "$tmp_dir/counted"
+
+echo '# opens classification guard origin'
+
+while read -r opens file
+do
+  guard=`sed -n \
+    '1,80{s/^[[:space:]]*#[[:space:]]*ifndef[[:space:]][[:space:]]*\([A-Za-z_][A-Za-z0-9_]*\).*$/\1/p;}' \
+    "$file" | sed -n '1p'`
+
+  first_conditional=`grep '^[[:space:]]*#[[:space:]]*if' "$file" \
+    | sed -n '1p' || true`
+  last_directive=`grep '^[[:space:]]*#' "$file" | tail -n 1 || true`
+
+  if test -n "$guard" \
+     && printf '%s\n' "$first_conditional" \
+          | grep "^[[:space:]]*#[[:space:]]*ifndef[[:space:]][[:space:]]*$guard\([[:space:]]\|$\)" \
+              >/dev/null 2>&1 \
+     && grep "^[[:space:]]*#[[:space:]]*define[[:space:]][[:space:]]*$guard\([[:space:]]\|$\)" \
+          "$file" >/dev/null 2>&1 \
+     && { printf '%s\n' "$last_directive" \
+            | grep '^[[:space:]]*#[[:space:]]*endif' >/dev/null 2>&1; }; then
+    classification=guarded
+  else
+    guard=-
+    case $file in
+      *.def|*.inc)
+        classification=deliberate-multi-review
+        ;;
+      *)
+        classification=unguarded-review
+        ;;
+    esac
+  fi
+
+  case $file in
+    "$source_root"/*)
+      origin=source:${file#"$source_root/"}
+      ;;
+    "$build_root"/*)
+      origin=build:${file#"$build_root/"}
+      ;;
+    *)
+      echo "error: unexpected audited path: $file" >&2
+      exit 1
+      ;;
+  esac
+
+  printf '%s\t%s\t%s\t%s\n' "$opens" "$classification" "$guard" "$origin"
+done < "$tmp_dir/counted"
diff --git a/contrib/audit-cc1-unified-symbols.sh b/contrib/audit-cc1-unified-symbols.sh
new file mode 100755
index 00000000..d2dd9430
--- /dev/null
+++ b/contrib/audit-cc1-unified-symbols.sh
@@ -0,0 +1,66 @@
+#!/bin/sh
+
+# Report file-scope symbols which collide when cc1 translation units are
+# combined.  This deliberately uses only tools required by a normal GCC build.
+
+set -eu
+
+if test "$#" -ne 1; then
+  echo "usage: $0 BUILD-DIR" >&2
+  exit 2
+fi
+
+build_dir=$1
+manifest=gcc/cc1-unified-sources.manifest
+output=gcc/cc1-unified-symbols.audit
+tmp=${TMPDIR-/tmp}/cc1-unified-symbols.$$
+trap 'rm -f "$tmp" "$tmp.sorted"' 0 1 2 3 15
+
+test -f "$manifest" || { echo "$manifest is missing" >&2; exit 1; }
+test -d "$build_dir/gcc" || { echo "$build_dir/gcc is missing" >&2; exit 1; }
+
+: > "$tmp"
+sed '1d' "$manifest" | while IFS="	" read order component object origin; do
+  case $component in
+    direct-*) object_file=$build_dir/gcc/$object ;;
+    backend-*) object_file=$build_dir/gcc/$object ;;
+    libcpp) object_file=$build_dir/libcpp/$object ;;
+    libdecnumber) object_file=$build_dir/libdecnumber/$object ;;
+    libiberty) object_file=$build_dir/libiberty/$object ;;
+    *) continue ;;
+  esac
+  test -f "$object_file" || { echo "missing object: $object_file" >&2; exit 1; }
+  nm -a "$object_file" | awk -v object="$component/$object" '
+    NF >= 3 && $2 ~ /^[bdrst]$/ && $3 !~ /^\./ &&
+    $3 !~ /^__FUNCTION__\./ && $3 != "gcc2_compiled." &&
+    $3 !~ /\.(c|o)$/ {
+      print $3 "\t" object "\t" $2
+    }' >> "$tmp"
+done
+
+LC_ALL=C sort -u "$tmp" > "$tmp.sorted"
+awk -F '	' '
+  function emit() {
+    if (count > 1) {
+      print count "\t" name "\t" locations
+    }
+  }
+  $1 != name {
+    if (name != "") emit()
+    name=$1; count=0; locations=""
+  }
+  {
+    count++
+    if (locations != "") locations=locations ","
+    locations=locations $2 "(" $3 ")"
+  }
+  END { if (name != "") emit() }
+' "$tmp.sorted" | LC_ALL=C sort -t "	" -k1,1nr -k2,2 > "$output.body"
+
+{
+  echo "# objects symbol locations"
+  cat "$output.body"
+} > "$output"
+rm -f "$output.body"
+
+echo "wrote $output"
diff --git a/contrib/benchmark-cc1-j1.sh b/contrib/benchmark-cc1-j1.sh
new file mode 100755
index 00000000..147157ee
--- /dev/null
+++ b/contrib/benchmark-cc1-j1.sh
@@ -0,0 +1,51 @@
+#!/bin/sh
+
+# Remove the conventional objects which feed cc1, then rebuild with one make
+# job.  Generated sources and generator programs are intentionally retained.
+
+set -eu
+
+if test "$#" -lt 1 || test "$#" -gt 2; then
+  echo "usage: $0 BUILD-DIR [TIMING-LOG]" >&2
+  exit 2
+fi
+
+build_dir=$1
+timing_log=${2-/dev/null}
+manifest=gcc/cc1-unified-sources.manifest
+
+case $build_dir in
+  /|/home|/home/foo|/home/foo/src) echo "refusing unsafe build directory" >&2; exit 1 ;;
+esac
+test -f "$build_dir/config.status" || { echo "$build_dir is not configured" >&2; exit 1; }
+test -f "$build_dir/gcc/Makefile" || { echo "$build_dir/gcc/Makefile is missing" >&2; exit 1; }
+test -f "$manifest" || { echo "$manifest is missing" >&2; exit 1; }
+
+sed '1d' "$manifest" | while IFS="	" read order component object origin; do
+  case $component in
+    direct-*|backend-*) rm -f "$build_dir/gcc/$object" ;;
+  esac
+done
+
+for component in libiberty libcpp libdecnumber; do
+  archive=$build_dir/$component/$component.a
+  if test -f "$archive"; then
+    ar t "$archive" | while IFS= read object; do
+      rm -f "$build_dir/$component/$object"
+    done
+  fi
+  rm -f "$archive"
+done
+rm -f "$build_dir/gcc/libbackend.a" "$build_dir/gcc/cc1" \
+  "$build_dir/gcc/cc1-dummy" "$build_dir/gcc/cc1-checksum.o"
+
+start=`date +%s`
+make -j1 -C "$build_dir/libiberty" all
+make -j1 -C "$build_dir/libcpp" libcpp.a
+make -j1 -C "$build_dir/libdecnumber" libdecnumber.a
+make -j1 -C "$build_dir/gcc" cc1
+finish=`date +%s`
+elapsed=`expr "$finish" - "$start"`
+size=`wc -c < "$build_dir/gcc/cc1" | tr -d ' '`
+echo "$elapsed	$size" >> "$timing_log"
+echo "conventional cc1: ${elapsed}s, ${size} bytes"
diff --git a/contrib/benchmark-cc1-unified-current.sh b/contrib/benchmark-cc1-unified-current.sh
new file mode 100755
index 00000000..002ff9e2
--- /dev/null
+++ b/contrib/benchmark-cc1-unified-current.sh
@@ -0,0 +1,112 @@
+#!/bin/sh
+
+# Compile the currently migrated implementation set either as conventional
+# translation units or through the checked unity drivers.  This deliberately
+# measures compilation only: archive rewriting and the final cc1 link are not
+# included in either side.
+
+set -eu
+
+test "$#" -eq 3 || {
+  echo "usage: $0 conventional|unified BUILD-DIR OUTPUT-DIR" >&2
+  exit 1
+}
+
+mode=$1
+build_root=`CDPATH= cd "$2" && pwd`
+output_root=$3
+script_dir=`dirname "$0"`
+source_root=`CDPATH= cd "$script_dir/.." && pwd`
+compiler=${CC-/usr/bin/gcc}
+manifest=$source_root/gcc/cc1-unified-chunks.manifest
+chunk_root=$output_root/chunks
+prefix_value=`sed -n 's/^prefix = //p' "$build_root/gcc/Makefile"`
+target_name=`sed -n 's/^target_noncanonical:=//p' "$build_root/gcc/Makefile"`
+base_version=`cat "$source_root/gcc/BASE-VER"`
+development_phase=`cat "$source_root/gcc/DEV-PHASE"`
+if test -n "$development_phase"; then
+  date_stamp=`cat "$source_root/gcc/DATESTAMP"`
+else
+  date_stamp=
+fi
+
+test -f "$build_root/gcc/Makefile" || {
+  echo "not a configured GCC build: $build_root" >&2
+  exit 1
+}
+test ! -e "$output_root" || {
+  echo "output path already exists: $output_root" >&2
+  exit 1
+}
+mkdir -p "$output_root" "$chunk_root"
+
+dec_flags="-c -O0 -g -I$build_root/libdecnumber -I$source_root/libdecnumber"
+core_flags="-c -O0 -g -DIN_GCC -DHAVE_CONFIG_H -I$build_root/gcc -I$source_root/gcc -I$source_root/include -I$source_root/libcpp/include -I$source_root/libdecnumber -I$build_root/libdecnumber"
+libcpp_flags="-c -O0 -g -DHAVE_CONFIG_H -I$build_root/libcpp -I$source_root/libcpp -I$source_root/libcpp/include -I$source_root/include"
+libiberty_flags="-c -O0 -g -DHAVE_CONFIG_H -I$build_root/libiberty -I$source_root/libiberty -I$source_root/include"
+
+case $mode in
+  conventional)
+    for source in tree.c tree-iterator.c tree-gimple.c; do
+      $compiler $core_flags "$source_root/gcc/$source" \
+        -o "$output_root/`basename "$source" .c`.o"
+    done
+    for source in decimal128.c decimal64.c decimal32.c decNumber.c decContext.c decUtility.c; do
+      $compiler $dec_flags "$source_root/libdecnumber/$source" \
+        -o "$output_root/`basename "$source" .c`.o"
+    done
+    while read chunk component order object origin; do
+      case $chunk in \#*) continue ;; esac
+      case $origin in
+        source:*) source=$source_root/${origin#source:} ;;
+        build:*) source=$build_root/${origin#build:} ;;
+        *) echo "unknown origin: $origin" >&2; exit 1 ;;
+      esac
+      case $component in
+        backend|direct) flags=$core_flags ;;
+        libcpp) flags=$libcpp_flags ;;
+        libiberty) flags=$libiberty_flags ;;
+        *) echo "unknown component: $component" >&2; exit 1 ;;
+      esac
+      case $object in
+        prefix.o)
+          extra_flags="-DPREFIX=\"$prefix_value\" -DBASEVER=\"$base_version\""
+          ;;
+        toplev.o)
+          extra_flags="-DTARGET_NAME=\"$target_name\""
+          ;;
+        version.o)
+          extra_flags="-DBASEVER=\"$base_version\" -DDATESTAMP=\"$date_stamp\" -DDEVPHASE=\"$development_phase\""
+          ;;
+        *) extra_flags= ;;
+      esac
+      $compiler $flags $extra_flags "$source" -o "$output_root/$chunk-$object"
+    done < "$manifest"
+    ;;
+  unified)
+    $compiler $core_flags "$source_root/gcc/cc1_unified.c" \
+      -o "$output_root/cc1_unified.o"
+    $compiler $dec_flags "$source_root/libdecnumber/decimal-unified.c" \
+      -o "$output_root/decimal-unified.o"
+    $compiler $dec_flags "$source_root/libdecnumber/decnumber-core-unified.c" \
+      -o "$output_root/decnumber-core-unified.o"
+    UNIFIED_CHUNK_MANIFEST=$manifest \
+      "$source_root/contrib/generate-cc1-unified-chunks.sh" \
+      "$build_root" "$chunk_root"
+    for chunk in `awk -F '\t' '!/^#/ {print $1}' "$manifest" | LC_ALL=C sort -u`; do
+      component=`awk -F '\t' -v chunk="$chunk" \
+        '$1 == chunk {print $2; exit}' "$manifest"`
+      case $component in
+        backend|direct) flags=$core_flags ;;
+        libcpp) flags=$libcpp_flags ;;
+        libiberty) flags=$libiberty_flags ;;
+        *) echo "unknown component: $component" >&2; exit 1 ;;
+      esac
+      $compiler $flags "$chunk_root/$chunk.c" -o "$chunk_root/$chunk.o"
+    done
+    ;;
+  *)
+    echo "mode must be conventional or unified" >&2
+    exit 1
+    ;;
+esac
diff --git a/contrib/benchmark-cc1-unified-pilots.sh b/contrib/benchmark-cc1-unified-pilots.sh
new file mode 100755
index 00000000..2fb4ccfb
--- /dev/null
+++ b/contrib/benchmark-cc1-unified-pilots.sh
@@ -0,0 +1,80 @@
+#!/bin/sh
+
+# Compare repeated separate and unified compilation for both pilot groups.
+
+set -eu
+
+if test "$#" -ne 2; then
+  echo "usage: $0 CONFIGURED-BUILD-DIR ARTIFACT-DIR" >&2
+  exit 2
+fi
+
+script_dir=`dirname "$0"`
+source_root=`CDPATH= cd "$script_dir/.." && pwd`
+build_root=$1
+artifact_root=$2
+tcc=${TCC-/tmp/tcc-0.9.27/bin/tcc}
+iterations=${ITERATIONS-20}
+
+case $iterations in
+  ''|*[!0-9]*|0) echo "ITERATIONS must be positive" >&2; exit 1 ;;
+esac
+test -f "$build_root/gcc/config.h" || { echo "configured build is missing" >&2; exit 1; }
+test -x "$tcc" || { echo "TCC is missing: $tcc" >&2; exit 1; }
+mkdir -p "$artifact_root"
+results=$artifact_root/unified-pilot-times.tsv
+echo "compiler	group	mode	iterations	seconds" > "$results"
+
+dec_flags="-c -O0 -g -I$build_root/libdecnumber -I$source_root/libdecnumber"
+core_flags="-c -O0 -g -DIN_GCC -DHAVE_CONFIG_H -I$build_root/gcc -I$source_root/gcc -I$source_root/include -I$source_root/libcpp/include -I$source_root/libdecnumber -I$build_root/libdecnumber"
+
+measure ()
+{
+  compiler=$1
+  tag=$2
+  group=$3
+  mode=$4
+  flags=$5
+  start=`date +%s`
+  count=0
+  while test "$count" -lt "$iterations"; do
+    if test "$group" = decimal && test "$mode" = separate; then
+      for name in decimal128 decimal64 decimal32; do
+        $compiler $flags "$source_root/libdecnumber/$name.c" \
+          -o "$artifact_root/bench-$tag-$name.o"
+      done
+    elif test "$group" = decimal; then
+      $compiler $flags "$source_root/libdecnumber/decimal-unified.c" \
+        -o "$artifact_root/bench-$tag-decimal-unified.o"
+    elif test "$mode" = separate; then
+      for name in tree tree-iterator tree-gimple; do
+        $compiler $flags "$source_root/gcc/$name.c" \
+          -o "$artifact_root/bench-$tag-$name.o"
+      done
+    else
+      $compiler $flags "$source_root/gcc/cc1_unified.c" \
+        -o "$artifact_root/bench-$tag-core-tree-unified.o"
+    fi
+    count=`expr "$count" + 1`
+  done
+  finish=`date +%s`
+  seconds=`expr "$finish" - "$start"`
+  echo "$tag	$group	$mode	$iterations	$seconds" | tee -a "$results"
+}
+
+for compiler in /usr/bin/gcc "$tcc"; do
+  case $compiler in
+    /usr/bin/gcc) tag=gcc ;;
+    *) tag=tcc ;;
+  esac
+  $compiler $dec_flags "$source_root/libdecnumber/decimal-unified.c" \
+    -o "$artifact_root/bench-$tag-decimal-warmup.o"
+  $compiler $core_flags "$source_root/gcc/cc1_unified.c" \
+    -o "$artifact_root/bench-$tag-core-warmup.o"
+  measure "$compiler" "$tag" decimal separate "$dec_flags"
+  measure "$compiler" "$tag" decimal unified "$dec_flags"
+  measure "$compiler" "$tag" core-tree separate "$core_flags"
+  measure "$compiler" "$tag" core-tree unified "$core_flags"
+done
+
+echo "wrote $results"
diff --git a/contrib/compare-cc1-unified-testsuite.sh b/contrib/compare-cc1-unified-testsuite.sh
new file mode 100755
index 00000000..5ab12620
--- /dev/null
+++ b/contrib/compare-cc1-unified-testsuite.sh
@@ -0,0 +1,45 @@
+#!/bin/sh
+
+# Compare a gcc.sum with the exact known unity-port baseline.  Any changed
+# XFAIL/UNRESOLVED identity or any FAIL/XPASS/ERROR requires human review.
+
+set -eu
+
+if test "$#" -ne 1; then
+  echo "usage: $0 PATH-TO-gcc.sum" >&2
+  exit 2
+fi
+
+script_dir=`dirname "$0"`
+source_root=`CDPATH= cd "$script_dir/.." && pwd`
+sum_file=$1
+known=$source_root/gcc/testsuite/cc1-unified-known-nonpasses.txt
+tmp=${TMPDIR-/tmp}/cc1-unified-testsuite.$$
+trap 'rm -f "$tmp" "$tmp.unexpected"' 0 1 2 3 15
+
+test -f "$sum_file" || { echo "testsuite summary is missing: $sum_file" >&2; exit 1; }
+test -f "$known" || { echo "known-result baseline is missing: $known" >&2; exit 1; }
+
+grep -E '^(XFAIL|UNRESOLVED):' "$sum_file" | LC_ALL=C sort > "$tmp"
+grep -E '^(FAIL|XPASS|ERROR):' "$sum_file" > "$tmp.unexpected" || true
+
+status=0
+if ! cmp "$known" "$tmp"; then
+  echo "known XFAIL/UNRESOLVED set changed:" >&2
+  diff -u "$known" "$tmp" >&2 || true
+  status=1
+fi
+
+if test -s "$tmp.unexpected"; then
+  echo "unexpected testsuite results:" >&2
+  cat "$tmp.unexpected" >&2
+  status=1
+fi
+
+for kind in PASS XFAIL FAIL XPASS UNRESOLVED UNTESTED UNSUPPORTED ERROR; do
+  count=`grep -c "^$kind:" "$sum_file" || true`
+  echo "$kind=$count"
+done
+
+test "$status" -eq 0 || exit "$status"
+echo "testsuite non-pass set matches the recorded baseline"
diff --git a/contrib/decimal-unified-smoke.c b/contrib/decimal-unified-smoke.c
new file mode 100644
index 00000000..195fef38
--- /dev/null
+++ b/contrib/decimal-unified-smoke.c
@@ -0,0 +1,53 @@
+#include <stdio.h>
+#include <string.h>
+
+/* The decNumber headers require the widest format first when several formats
+   share a translation unit.  */
+#include "decimal128.h"
+#include "decimal64.h"
+#include "decimal32.h"
+
+static int
+check_format (int kind, const char *input)
+{
+  decContext context;
+  decNumber number;
+  char output[DECIMAL128_String];
+
+  decContextDefault (&context, kind);
+  decNumberFromString (&number, input, &context);
+
+  if (kind == DEC_INIT_DECIMAL128)
+    {
+      decimal128 value;
+      decimal128FromNumber (&value, &number, &context);
+      decimal128ToString (&value, output);
+    }
+  else if (kind == DEC_INIT_DECIMAL64)
+    {
+      decimal64 value;
+      decimal64FromNumber (&value, &number, &context);
+      decimal64ToString (&value, output);
+    }
+  else
+    {
+      decimal32 value;
+      decimal32FromNumber (&value, &number, &context);
+      decimal32ToString (&value, output);
+    }
+
+  puts (output);
+  return output[0] == '\0';
+}
+
+int
+main (void)
+{
+  int failed = 0;
+
+  failed |= check_format (DEC_INIT_DECIMAL128,
+                          "1234567890123456789012345678901234E-20");
+  failed |= check_format (DEC_INIT_DECIMAL64, "-1234567890123456E-10");
+  failed |= check_format (DEC_INIT_DECIMAL32, "7654321E-3");
+  return failed;
+}
diff --git a/contrib/generate-cc1-unified-chunks.sh b/contrib/generate-cc1-unified-chunks.sh
new file mode 100755
index 00000000..eec3c2da
--- /dev/null
+++ b/contrib/generate-cc1-unified-chunks.sh
@@ -0,0 +1,81 @@
+#!/bin/sh
+
+# Generate the checked low-hanging unity chunks from their tracked manifest.
+
+set -eu
+
+if test "$#" -ne 2; then
+  echo "usage: $0 CONFIGURED-BUILD-DIR OUTPUT-DIR" >&2
+  exit 2
+fi
+
+script_dir=`dirname "$0"`
+source_root=`CDPATH= cd "$script_dir/.." && pwd`
+build_root=$1
+output_root=$2
+manifest=${UNIFIED_CHUNK_MANIFEST-$source_root/gcc/cc1-unified-chunks.manifest}
+prefix_value=`sed -n 's/^prefix = //p' "$build_root/gcc/Makefile"`
+target_name=`sed -n 's/^target_noncanonical:=//p' "$build_root/gcc/Makefile"`
+base_version=`cat "$source_root/gcc/BASE-VER"`
+development_phase=`cat "$source_root/gcc/DEV-PHASE"`
+if test -n "$development_phase"; then
+  date_stamp=`cat "$source_root/gcc/DATESTAMP"`
+else
+  date_stamp=
+fi
+
+test -f "$manifest" || { echo "unity chunk manifest is missing" >&2; exit 1; }
+test -f "$build_root/gcc/config.h" || { echo "configured build is missing" >&2; exit 1; }
+mkdir -p "$output_root"
+
+awk -F '\t' '!/^#/ {print $1 "\t" $2}' "$manifest" | LC_ALL=C sort -u | \
+while IFS="	" read chunk component; do
+  driver=$output_root/$chunk.c
+  echo "/* Generated from gcc/cc1-unified-chunks.manifest.  */" > "$driver"
+  case $component in
+    backend|direct) echo '#define GCC_UNIFIED_CC1 1' >> "$driver" ;;
+  esac
+  awk -F '\t' -v chunk="$chunk" -v source_root="$source_root" \
+      -v build_root="$build_root" -v prefix_value="$prefix_value" \
+      -v target_name="$target_name" -v base_version="$base_version" \
+      -v date_stamp="$date_stamp" -v development_phase="$development_phase" '
+    $1 == chunk {
+      origin=$5
+      original_origin=origin
+      if (origin ~ /^source:/) {
+        sub(/^source:/, "", origin)
+        include_path=source_root "/" origin
+      } else if (origin ~ /^build:/) {
+        sub(/^build:/, "", origin)
+        include_path=build_root "/" origin
+      } else {
+        print "bad unity origin: " origin > "/dev/stderr"
+        exit 1
+      }
+      if (original_origin == "source:gcc/prefix.c") {
+        print "#define PREFIX \"" prefix_value "\""
+        print "#define BASEVER \"" base_version "\""
+      } else if (original_origin == "source:gcc/toplev.c") {
+        print "#define TARGET_NAME \"" target_name "\""
+      } else if (original_origin == "source:gcc/version.c") {
+        print "#define BASEVER \"" base_version "\""
+        print "#define DATESTAMP \"" date_stamp "\""
+        print "#define DEVPHASE \"" development_phase "\""
+      }
+      print "#include \"" include_path "\""
+      print "#include \"" source_root "/gcc/core-tree-unified-boundary.h\""
+      if (original_origin == "source:gcc/prefix.c") {
+        print "#undef PREFIX"
+        print "#undef BASEVER"
+      } else if (original_origin == "source:gcc/toplev.c") {
+        print "#undef TARGET_NAME"
+      } else if (original_origin == "source:gcc/version.c") {
+        print "#undef BASEVER"
+        print "#undef DATESTAMP"
+        print "#undef DEVPHASE"
+      }
+    }
+  ' "$manifest" >> "$driver"
+done
+
+echo "generated unity chunks in $output_root"
diff --git a/contrib/generate-cc1-unified-prototype.sh b/contrib/generate-cc1-unified-prototype.sh
