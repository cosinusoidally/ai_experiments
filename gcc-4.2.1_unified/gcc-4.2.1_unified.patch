diff --git a/contrib/manifest-cc1-unified-generated.sh b/contrib/manifest-cc1-unified-generated.sh
new file mode 100755
index 00000000..a187c2de
--- /dev/null
+++ b/contrib/manifest-cc1-unified-generated.sh
@@ -0,0 +1,35 @@
+#!/bin/sh
+
+# Record configured files reached by the cc1 unity prototype.  Hashes make the
+# generated-input boundary reviewable without checking generated files in.
+
+set -eu
+
+if test "$#" -ne 1; then
+  echo "usage: $0 BUILD-DIR" >&2
+  exit 2
+fi
+
+build_dir=$1
+sources=gcc/cc1-unified-sources.manifest
+headers=gcc/cc1-unified-headers.audit
+output=gcc/cc1-unified-generated.manifest
+tmp=${TMPDIR-/tmp}/cc1-unified-generated.$$
+trap 'rm -f "$tmp" "$tmp.sorted"' 0 1 2 3 15
+
+: > "$tmp"
+awk -F '	' '$4 ~ /^build:/ { sub(/^build:/, "", $4); print $4 }' "$sources" >> "$tmp"
+awk -F '	' '$4 ~ /^build:/ { sub(/^build:/, "", $4); print $4 }' "$headers" >> "$tmp"
+for file in libcpp/config.h libdecnumber/config.h libiberty/config.h; do
+  test -f "$build_dir/$file" && echo "$file" >> "$tmp"
+done
+LC_ALL=C sort -u "$tmp" > "$tmp.sorted"
+
+echo "# sha256 build-relative-path" > "$output"
+while IFS= read file; do
+  test -f "$build_dir/$file" || { echo "missing generated input: $build_dir/$file" >&2; exit 1; }
+  hash=`sha256sum "$build_dir/$file" | awk '{print $1}'`
+  echo "$hash	$file" >> "$output"
+done < "$tmp.sorted"
+
+echo "wrote $output"
diff --git a/contrib/place-cc1-unified-remainders.sh b/contrib/place-cc1-unified-remainders.sh
new file mode 100755
index 00000000..3cab6e96
--- /dev/null
+++ b/contrib/place-cc1-unified-remainders.sh
@@ -0,0 +1,90 @@
+#!/bin/sh
+
+# Try each backend implementation against every established backend unity
+# chunk.  This is a porting aid: it writes a proposed placements manifest and
+# a deferred list, but never edits the checked source manifest.
+
+set -eu
+
+test "$#" -eq 3 || {
+  echo "usage: $0 INPUT.tsv CONFIGURED-BUILD OUTPUT-DIR" >&2
+  exit 1
+}
+
+input=$1
+build_root=`CDPATH= cd "$2" && pwd`
+output_root=$3
+script_dir=`dirname "$0"`
+source_root=`CDPATH= cd "$script_dir/.." && pwd`
+manifest=$source_root/gcc/cc1-unified-chunks.manifest
+gcc_compiler=${GCC_CC-/usr/bin/gcc}
+tcc_compiler=${TCC_CC-/tmp/tcc-0.9.27/bin/tcc}
+flags="-c -O0 -g -DIN_GCC -DHAVE_CONFIG_H -I$build_root/gcc -I$source_root/gcc -I$source_root/include -I$source_root/libcpp/include -I$source_root/libdecnumber -I$build_root/libdecnumber ${EXTRA_FLAGS-}"
+
+test -f "$input" || { echo "input is missing: $input" >&2; exit 1; }
+test -f "$build_root/gcc/config.h" || {
+  echo "configured GCC build is missing: $build_root" >&2
+  exit 1
+}
+test ! -e "$output_root" || {
+  echo "output path already exists: $output_root" >&2
+  exit 1
+}
+mkdir -p "$output_root/drivers" "$output_root/logs"
+: > "$output_root/placements.tsv"
+: > "$output_root/deferred.tsv"
+
+source_path ()
+{
+  case $1 in
+    source:*) echo "$source_root/${1#source:}" ;;
+    build:*) echo "$build_root/${1#build:}" ;;
+    *) echo "bad origin: $1" >&2; exit 1 ;;
+  esac
+}
+
+while IFS='	' read order class object origin; do
+  case $class in
+    backend-*) component=backend ;;
+    direct-*) component=direct ;;
+    *) echo "not a cc1 implementation row: $class" >&2; exit 1 ;;
+  esac
+  item=`echo "$object" | sed 's/[^A-Za-z0-9]/_/g'`
+  placed=no
+  for chunk in `awk -F '\t' -v component="$component" \
+      '!/^#/ && $2 == component {print $1}' "$manifest" | LC_ALL=C sort -u`; do
+    driver=$output_root/drivers/$item-$chunk.c
+    echo '/* Candidate merged unity chunk.  */' > "$driver"
+    echo '#define GCC_UNIFIED_CC1 1' >> "$driver"
+    awk -F '\t' -v chunk="$chunk" '$1 == chunk {print $5}' \
+      "$manifest" "$output_root/placements.tsv" | \
+    while read member_origin; do
+      member=`source_path "$member_origin"`
+      echo "#include \"$member\""
+      echo "#include \"$source_root/gcc/core-tree-unified-boundary.h\""
+    done >> "$driver"
+    member=`source_path "$origin"`
+    echo "#include \"$member\"" >> "$driver"
+    echo "#include \"$source_root/gcc/core-tree-unified-boundary.h\"" >> "$driver"
+
+    if $gcc_compiler $flags "$driver" -o "$output_root/$item.o" \
+         > "$output_root/logs/$item-$chunk-gcc.log" 2>&1 && \
+       $tcc_compiler $flags "$driver" -o "$output_root/$item.o" \
+         > "$output_root/logs/$item-$chunk-tcc.log" 2>&1; then
+      printf '%s\t%s\t%s\t%s\t%s\n' \
+        "$chunk" "$component" "$order" "$object" "$origin" \
+        >> "$output_root/placements.tsv"
+      echo "ACCEPT $object -> $chunk"
+      placed=yes
+      break
+    fi
+  done
+  if test "$placed" = no; then
+    printf '%s\t%s\t%s\t%s\n' "$order" "$class" "$object" "$origin" \
+      >> "$output_root/deferred.tsv"
+    echo "DEFER $object"
+  fi
+done < "$input"
+
+echo "placed files: `wc -l < "$output_root/placements.tsv" | tr -d ' '`"
+echo "deferred files: `wc -l < "$output_root/deferred.tsv" | tr -d ' '`"
diff --git a/contrib/test-cc1-unified-pilots.sh b/contrib/test-cc1-unified-pilots.sh
new file mode 100755
index 00000000..873604eb
--- /dev/null
+++ b/contrib/test-cc1-unified-pilots.sh
@@ -0,0 +1,125 @@
+#!/bin/sh
+
+# Build and validate the decimal and core-tree Milestone 2 unity pilots.
+# This script uses only normal GCC build tools plus the requested TCC compiler.
+
+set -eu
+
+if test "$#" -ne 2; then
+  echo "usage: $0 CONFIGURED-BUILD-DIR ARTIFACT-DIR" >&2
+  exit 2
+fi
+
+script_dir=`dirname "$0"`
+source_root=`CDPATH= cd "$script_dir/.." && pwd`
+build_root=$1
+artifact_root=$2
+tcc=${TCC-/tmp/tcc-0.9.27/bin/tcc}
+
+test -f "$build_root/gcc/Makefile" || { echo "configured build is missing" >&2; exit 1; }
+test -f "$build_root/gcc/cc1" || { echo "conventional cc1 is missing" >&2; exit 1; }
+test -x "$tcc" || { echo "TCC is missing: $tcc" >&2; exit 1; }
+mkdir -p "$artifact_root"
+
+dec_flags="-c -O0 -g -I$build_root/libdecnumber -I$source_root/libdecnumber"
+core_flags="-c -O0 -g -DIN_GCC -DHAVE_CONFIG_H -I$build_root/gcc -I$source_root/gcc -I$source_root/include -I$source_root/libcpp/include -I$source_root/libdecnumber -I$build_root/libdecnumber"
+
+for compiler in /usr/bin/gcc "$tcc"; do
+  case $compiler in
+    /usr/bin/gcc) tag=gcc ;;
+    *) tag=tcc ;;
+  esac
+
+  $compiler $dec_flags "$source_root/libdecnumber/decimal-unified.c" \
+    -o "$artifact_root/decimal-unified-$tag.o"
+  for name in decimal128 decimal64 decimal32; do
+    $compiler $dec_flags "$source_root/libdecnumber/$name.c" \
+      -o "$artifact_root/$name-$tag.o"
+  done
+
+  $compiler $core_flags "$source_root/gcc/cc1_unified.c" \
+    -o "$artifact_root/core-tree-unified-$tag.o"
+  for name in tree tree-iterator tree-gimple; do
+    $compiler $core_flags "$source_root/gcc/$name.c" \
+      -o "$artifact_root/core-$name-$tag.o"
+  done
+done
+
+compare_symbols ()
+{
+  group=$1
+  tag=$2
+  shift 2
+  conventional=$artifact_root/$group-conventional-$tag.symbols
+  unified=$artifact_root/$group-unified-$tag.symbols
+  nm -g --defined-only "$@" | awk 'NF >= 3 {print $3}' | \
+    LC_ALL=C sort -u > "$conventional"
+  nm -g --defined-only "$artifact_root/$group-unified-$tag.o" | \
+    awk 'NF >= 3 {print $3}' | LC_ALL=C sort -u > "$unified"
+  cmp "$conventional" "$unified"
+}
+
+for tag in gcc tcc; do
+  compare_symbols decimal "$tag" \
+    "$artifact_root/decimal128-$tag.o" \
+    "$artifact_root/decimal64-$tag.o" \
+    "$artifact_root/decimal32-$tag.o"
+  compare_symbols core-tree "$tag" \
+    "$artifact_root/core-tree-$tag.o" \
+    "$artifact_root/core-tree-iterator-$tag.o" \
+    "$artifact_root/core-tree-gimple-$tag.o"
+
+  cp "$build_root/libdecnumber/libdecnumber.a" \
+    "$artifact_root/libdecnumber-unified-$tag.a"
+  ar d "$artifact_root/libdecnumber-unified-$tag.a" \
+    decimal128.o decimal64.o decimal32.o
+  ar r "$artifact_root/libdecnumber-unified-$tag.a" \
+    "$artifact_root/decimal-unified-$tag.o"
+  ranlib "$artifact_root/libdecnumber-unified-$tag.a"
+
+  cp "$build_root/gcc/libbackend.a" \
+    "$artifact_root/libbackend-core-unified-$tag.a"
+  ar d "$artifact_root/libbackend-core-unified-$tag.a" \
+    tree.o tree-iterator.o tree-gimple.o
+  ar r "$artifact_root/libbackend-core-unified-$tag.a" \
+    "$artifact_root/core-tree-unified-$tag.o"
+  ranlib "$artifact_root/libbackend-core-unified-$tag.a"
+done
+
+for tag in conventional unified-gcc unified-tcc; do
+  case $tag in
+    conventional) archive=$build_root/libdecnumber/libdecnumber.a ;;
+    *) archive=$artifact_root/libdecnumber-$tag.a ;;
+  esac
+  /usr/bin/gcc -O0 -g -I"$build_root/libdecnumber" \
+    -I"$source_root/libdecnumber" "$source_root/contrib/decimal-unified-smoke.c" \
+    "$archive" -o "$artifact_root/decimal-smoke-$tag"
+  "$artifact_root/decimal-smoke-$tag" > "$artifact_root/decimal-smoke-$tag.out"
+done
+cmp "$artifact_root/decimal-smoke-conventional.out" \
+  "$artifact_root/decimal-smoke-unified-gcc.out"
+cmp "$artifact_root/decimal-smoke-conventional.out" \
+  "$artifact_root/decimal-smoke-unified-tcc.out"
+
+saved_cc1=$build_root/gcc/cc1.unified-pilot-save
+test ! -e "$saved_cc1" || { echo "stale saved cc1 exists: $saved_cc1" >&2; exit 1; }
+mv "$build_root/gcc/cc1" "$saved_cc1"
+restore_cc1 ()
+{
+  test ! -f "$saved_cc1" || mv -f "$saved_cc1" "$build_root/gcc/cc1"
+}
+trap restore_cc1 0 1 2 3 15
+
+for tag in gcc tcc; do
+  make -C "$build_root/gcc" cc1 \
+    LIBDECNUMBER="$artifact_root/libdecnumber-unified-$tag.a"
+  mv "$build_root/gcc/cc1" "$artifact_root/cc1-decimal-unified-$tag"
+
+  make -C "$build_root/gcc" cc1 \
+    BACKEND="main.o $artifact_root/libbackend-core-unified-$tag.a ../libcpp/libcpp.a ../libdecnumber/libdecnumber.a"
+  mv "$build_root/gcc/cc1" "$artifact_root/cc1-core-unified-$tag"
+done
+restore_cc1
+trap - 0 1 2 3 15
+
+echo "decimal and core-tree unity pilots passed"
