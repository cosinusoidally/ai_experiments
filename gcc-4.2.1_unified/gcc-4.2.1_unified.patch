+#!/bin/sh
+
+# Configure (when necessary) and build conventional, non-unified cc1 from an
+# out-of-tree build directory.  Keep builds under /home/foo/src/builds, e.g.
+# mkdir -p ../builds/conventional && cd ../builds/conventional && ../../gcc-4.2.1/build.sh
+
+set -eu
+
+script_dir=`dirname "$0"`
+src_dir=`CDPATH= cd "$script_dir" && pwd`
+build_dir=`pwd`
+
+if test "$build_dir" = "$src_dir"; then
+  echo "build.sh must be run from an out-of-tree build directory" >&2
+  exit 1
+fi
+
+prefix=${PREFIX-/tmp/gcc-4.2.1}
+jobs=${JOBS-1}
+languages=${LANGUAGES-c}
+make_program=${MAKE-make}
+
+if test ! -f Makefile; then
+  "$src_dir/configure" \
+    --build=i686-pc-linux-gnu \
+    --host=i686-pc-linux-gnu \
+    --target=i686-pc-linux-gnu \
+    --prefix="$prefix" \
+    --disable-nls \
+    --disable-multilib \
+    --disable-bootstrap \
+    --enable-languages="$languages" \
+    ${CONFIGURE_FLAGS-}
+fi
+
+if test "$#" -eq 0; then
+  set -- all-gcc
+fi
+
+exec "$make_program" -j"$jobs" "$@"
