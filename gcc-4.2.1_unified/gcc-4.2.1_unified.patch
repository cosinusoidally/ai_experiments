diff --git a/gcc/core-tree-unified-boundary.h b/gcc/core-tree-unified-boundary.h
new file mode 100644
index 00000000..22c77def
--- /dev/null
+++ b/gcc/core-tree-unified-boundary.h
@@ -0,0 +1,45 @@
+/* Translation-unit boundary for the core tree-IR unity pilot.
+
+   This header is intentionally repeatable.  Boundary restorations discovered
+   by compiling the pilot belong here; conventional builds never include it.  */
+
+/* dwarf2asm.c and safe-ctype.c use S as an implementation-local table
+   initializer shorthand.  A conventional preprocessing unit drops it at EOF;
+   reproduce that boundary for the next included implementation.  */
+#undef S
+
+/* Implementation shorthands emitted by emit-rtl.c and genattrtab.  */
+#undef last_insn
+#undef first_insn
+#undef cur_insn_uid
+#undef last_location
+#undef first_label_num
+#undef operands
+
+/* tree-nested.c deliberately poisons this name for the remainder of its
+   conventional translation unit.  A unified source boundary ends that
+   deliberately local prohibition.  */
+#undef create_tmp_var
+
+/* ifcvt.c supplies a translation-unit-local default.  optabs.c must get the
+   chance to supply its matching generator fallback independently.  */
+#undef HAVE_conditional_trap
+#undef gen_conditional_trap
+
+/* combine.c and cse.c specialize these initializer fields for their private
+   hook tables.  In separate translation units those definitions disappear at
+   EOF.  Restore the rtlhooks-def.h defaults so general_rtl_hooks is genuinely
+   general when rtlhooks.c is included later in the unity driver.  */
+#undef RTL_HOOKS_GEN_LOWPART
+#undef RTL_HOOKS_GEN_LOWPART_NO_EMIT
+#undef RTL_HOOKS_REG_NONZERO_REG_BITS
+#undef RTL_HOOKS_REG_NUM_SIGN_BIT_COPIES
+#undef RTL_HOOKS_REG_TRUNCATED_TO_MODE
+#define RTL_HOOKS_GEN_LOWPART gen_lowpart_general
+#define RTL_HOOKS_GEN_LOWPART_NO_EMIT gen_lowpart_no_emit_general
+#define RTL_HOOKS_REG_NONZERO_REG_BITS reg_nonzero_bits_general
+#define RTL_HOOKS_REG_NUM_SIGN_BIT_COPIES reg_num_sign_bit_copies_general
+#define RTL_HOOKS_REG_TRUNCATED_TO_MODE reg_truncated_to_mode_general
+
+/* rtlanal.c uses this poison macro only to police recursion in that file.  */
+#undef cached_num_sign_bit_copies
