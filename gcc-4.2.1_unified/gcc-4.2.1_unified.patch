diff --git a/report-cc1-unified-progress.sh b/report-cc1-unified-progress.sh
new file mode 100755
index 00000000..e59eeb5f
--- /dev/null
+++ b/report-cc1-unified-progress.sh
@@ -0,0 +1,86 @@
+#!/bin/sh
+
+# Compare the cc1 and libiberty unity includes with the conventional closure.
+
+set -eu
+
+source_root=`CDPATH= cd "\`dirname "$0"\`" && pwd`
+manifest=$source_root/gcc/cc1-unified-sources.manifest
+tmp=${TMPDIR-/tmp}/cc1-unified-progress.$$
+trap 'rm -f "$tmp" "$tmp.sorted"' 0 1 2 3 15
+
+test -f "$manifest" || {
+  echo "source closure manifest is missing" >&2
+  exit 1
+}
+
+awk -F '\t' '
+  NR == FNR {
+    if (!/^#/)
+      {
+        valid[$4] = 1
+        if ($4 ~ /^build:gcc\//)
+          {
+            name = $4
+            sub(/^build:gcc\//, "", name)
+            generated[name] = $4
+          }
+      }
+    next
+  }
+
+  /^#include "[^"]*\.c"/ {
+    name = $0
+    sub(/^[^"]*"/, "", name)
+    sub(/".*/, "", name)
+    if (name ~ /^\.\.\//)
+      {
+        sub(/^\.\.\//, "", name)
+        origin = "source:" name
+      }
+    else if (FILENAME ~ /libiberty_unified\.c$/)
+      origin = "source:libiberty/" name
+    else if (name in generated)
+      origin = generated[name]
+    else
+      origin = "source:gcc/" name
+
+    if (!valid[origin])
+      {
+        # The complete unified libiberty archive deliberately contains more
+        # implementation files than cc1 pulls from an ordinary archive.
+        if (FILENAME !~ /libiberty_unified\.c$/)
+          {
+            print "unified include is outside the selected closure: " origin > "/dev/stderr"
+            bad = 1
+          }
+      }
+    else
+      print origin
+  }
+
+  END { exit bad }
+' "$manifest" "$source_root/gcc/cc1_unified.c" \
+  "$source_root/libiberty/libiberty_unified.c" > "$tmp"
+
+LC_ALL=C sort -u "$tmp" > "$tmp.sorted"
+total=`awk -F '\t' '!/^#/ {count++} END {print count+0}' "$manifest"`
+unified=`wc -l < "$tmp.sorted" | tr -d ' '`
+remaining=`awk -v total="$total" -v unified="$unified" \
+  'BEGIN {print total - unified}'`
+
+awk -F '\t' 'NR == FNR {seen[$1] = 1; next} !/^#/ && !seen[$4] {print $4}' \
+  "$tmp.sorted" "$manifest" > "$tmp"
+
+percent=`awk -v unified="$unified" -v total="$total" \
+  'BEGIN {if (total == 0) print "0.00"; else printf "%.2f", unified * 100 / total}'`
+
+echo "Unified cc1 port progress"
+echo "  unified implementation files: $unified"
+echo "  total linked implementation files: $total"
+echo "  remaining implementation files: $remaining"
+echo "  progress: $percent%"
+if test -s "$tmp"; then
+  echo "  remaining files:"
+  sed 's/^/    /' "$tmp"
+fi
